# Copy to .env and fill in:  cp env.example .env
#
# Generate the ops account and populate OPS_SEED below:
#
#   node scripts/generate-ops-key.mjs   # writes secrets/ops_seed, prints addresses
#   node scripts/seed-to-env.mjs        # copies that mnemonic into .env
#
# .env is gitignored and written mode 600. Note that as an environment variable the
# seed is readable via `docker inspect` and `docker compose config` on the host, so
# the host itself must be access-controlled.

# Ops mnemonic. Twelve words. Leave empty here; it is set in .env, never committed.
OPS_SEED=

# --- Paseo TestNet -----------------------------------------------------------------
# Probed 2026-08-16: paseo-bulletin-rpc (the endpoint named in the official docs) does
# not respond; paseo-bulletin-next-rpc is live. Following the tutorial gets you a silent
# hang, not an error, so this default is deliberate.
BULLETIN_WS=wss://paseo-bulletin-next-rpc.polkadot.io

# Society lives on Asset Hub Kusama regardless of which Bulletin network stores the
# images — membership is real even while storage is on a testnet.
ASSET_HUB_WS=wss://kusama-asset-hub-rpc.polkadot.io

# Exact origins, comma-separated. No wildcards.
ALLOWED_ORIGINS=https://kappasigmamu.github.io

# Wallpaper image cap (app policy; Bulletin's own per-transaction ceiling is ~8 MiB).
MAX_IMAGE_BYTES=2097152

# Verification video: inbound cap before compression, and the post-compression target
# the backend transcodes to (kept under Bulletin's ~8 MiB single-transaction limit).
MAX_VIDEO_BYTES=104857600
COMPRESSED_VIDEO_TARGET_BYTES=7340032

# --- Element / Matrix voting room --------------------------------------------------
# The backend posts each verification video here as an m.video event (docs/adr/0003).
# MATRIX_TOKEN is a secret: set it in .env, never commit it. Create a dedicated bot
# account, invite it to the room, and use its access token. Leave token/room empty to
# skip posting (uploads still succeed) — e.g. on a dev box with no voting room.
MATRIX_HOMESERVER=https://matrix.org
MATRIX_TOKEN=
MATRIX_ROOM=

# Off-chain caches, both rebuildable from chain. Mount a persistent volume at ./data.
REGISTRY_PATH=./data/registry.json
IMAGE_CACHE_DIR=./data/images

# IPFS gateway: the backfill source behind the image cache. The documented Paseo gateway
# is currently unreachable, so this is empty by default; set it on mainnet.
IPFS_GATEWAY=

# Refresh the ops authorization when it is within this many blocks of expiring.
# 24s blocks: 10000 blocks is a little under three days of warning.
RENEWAL_WARNING_BLOCKS=10000

# --- Local dev chain only ----------------------------------------------------------
# Both MUST stay false anywhere real.
#   SUDO_BOOTSTRAP    lets the setup script call add_authorizer via //Alice sudo
#   ALLOW_DEV_SIGNING turns /dev-sign into a signing oracle for any dev seed
SUDO_BOOTSTRAP=false
ALLOW_DEV_SIGNING=false
